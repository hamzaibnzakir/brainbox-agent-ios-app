{
  "name": "brainbox-desktop",
  "productName": "Brainbox",
  "version": "2.0.0",
  "description": "Brainbox for Windows: chat with Hermes on your server, watch its screen, take over, hand back.",
  "author": "Brainbox",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.3.0",
    "marked": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "1.17.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "44.9.3",
    "electron-builder": "26.0.12",
    "playwright-core": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
